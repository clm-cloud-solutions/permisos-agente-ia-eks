# Copia este archivo a lab.env y ajústalo: cp lab.env.example lab.env
# lab.env no se sube al repositorio. Los tokens y claves nunca van aquí: los pide
# `make kubebolt` y quedan en .lab/ con permisos 600.

# Dónde corre el laboratorio:
#   local  kind en tu máquina, sin cuenta de AWS (docs/local.md)
#   aws    EKS, RDS y Secrets Manager en tu cuenta (docs/aws.md); ~0,25 USD/h
LAB_MODE=local

# A qué KubeBolt se conecta el clúster (docs/kubebolt.md):
#   cloud  KubeBolt Cloud, plan Free incluido: https://app.kubebolt.io/signup
#   oss    KubeBolt open source instalado en el propio clúster, con tu clave de LLM
KUBEBOLT=cloud

# ---- Solo con LAB_MODE=aws -------------------------------------------------
# Un perfil de AWS CLI con permisos de administrador, mejor en una cuenta de pruebas.
AWS_PROFILE=
AWS_REGION=us-east-2
# 2× t4g.medium alcanzan para la tienda, External Secrets y el agente. Con KubeBolt
# open source dentro del clúster, usa t4g.large.
NODE_TYPE=t4g.medium
NODE_COUNT=2

# Conector de AWS de KubeBolt: quién asume el rol de solo lectura (permisos-ia-kubebolt-readonly).
#   Vacío: el backend de KubeBolt open source del clúster (KUBEBOLT=oss).
#   KubeBolt Cloud (plan Team): el principal y el External ID que muestra el
#   asistente del conector de AWS. Después de cambiarlos, vuelve a lanzar make up.
KUBEBOLT_AWS_PRINCIPAL_ARN=
KUBEBOLT_EXTERNAL_ID=

# ---- Solo con KUBEBOLT=oss -------------------------------------------------
# Proveedor de LLM para Kobi: anthropic, u openai para cualquier API compatible
# (OpenAI, xAI, DeepSeek, Groq, OpenRouter, Ollama…; con KUBEBOLT_AI_BASE_URL).
KUBEBOLT_AI_PROVIDER=anthropic
KUBEBOLT_AI_MODEL=
KUBEBOLT_AI_BASE_URL=
