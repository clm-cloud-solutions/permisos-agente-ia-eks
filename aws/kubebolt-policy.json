{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "KubeBoltReadOnly",
      "Effect": "Allow",
      "Action": [
        "application-signals:BatchGet*",
        "application-signals:Get*",
        "application-signals:List*",
        "autoscaling:Describe*",
        "ce:Get*",
        "cloudtrail:LookupEvents",
        "cloudwatch:Describe*",
        "cloudwatch:Get*",
        "cloudwatch:ListMetrics",
        "compute-optimizer:Get*",
        "cost-optimization-hub:List*",
        "dynamodb:Describe*",
        "dynamodb:List*",
        "ec2:Describe*",
        "ecr:Describe*",
        "ecr:GetLifecyclePolicy",
        "ecr:GetRepositoryPolicy",
        "ecr:List*",
        "eks:Describe*",
        "eks:List*",
        "elasticache:Describe*",
        "elasticache:ListTagsForResource",
        "elasticfilesystem:Describe*",
        "elasticloadbalancing:Describe*",
        "health:Describe*",
        "iam:GetInstanceProfile",
        "iam:GetPolicy",
        "iam:GetPolicyVersion",
        "iam:GetRole",
        "iam:GetRolePolicy",
        "iam:List*",
        "iam:SimulatePrincipalPolicy",
        "kafka:Describe*",
        "kafka:List*",
        "kms:DescribeKey",
        "kms:Get*",
        "kms:List*",
        "lambda:GetFunctionConcurrency",
        "lambda:GetFunctionConfiguration",
        "lambda:ListEventSourceMappings",
        "logs:Describe*",
        "logs:FilterLogEvents",
        "logs:Get*",
        "logs:StartQuery",
        "logs:StopQuery",
        "memorydb:Describe*",
        "memorydb:ListTags",
        "pi:DescribeDimensionKeys",
        "pi:GetResourceMetrics",
        "pi:ListAvailableResourceMetrics",
        "pricing:Describe*",
        "pricing:Get*",
        "pricing:List*",
        "rds:Describe*",
        "rds:ListTagsForResource",
        "redshift:Describe*",
        "route53:Get*",
        "route53:List*",
        "s3:GetBucketLocation",
        "s3:GetBucketPolicy",
        "s3:GetEncryptionConfiguration",
        "s3:List*",
        "secretsmanager:DescribeSecret",
        "secretsmanager:List*",
        "servicequotas:Get*",
        "servicequotas:ListServiceQuotas",
        "sns:GetTopicAttributes",
        "sns:List*",
        "sqs:Get*",
        "sqs:List*",
        "ssm:DescribeParameters",
        "sts:GetCallerIdentity",
        "support:DescribeTrustedAdvisor*",
        "xray:BatchGetTraces",
        "xray:Get*"
      ],
      "Resource": "*"
    },
    {
      "Sid": "NeverSecretsOrData",
      "Effect": "Deny",
      "Action": [
        "autoscaling:DescribeLaunchConfigurations",
        "dynamodb:BatchGetItem",
        "dynamodb:GetItem",
        "dynamodb:PartiQLSelect",
        "dynamodb:Query",
        "dynamodb:Scan",
        "ec2:DescribeInstanceAttribute",
        "ec2:DescribeLaunchTemplateVersions",
        "ec2:DescribeSpotFleetRequests",
        "ec2:DescribeSpotInstanceRequests",
        "ec2:GetPasswordData",
        "ecr:GetAuthorizationToken",
        "ecr:GetDownloadUrlForLayer",
        "iam:GetCredentialReport",
        "kms:Decrypt",
        "lambda:GetFunction",
        "lambda:GetLayerVersion",
        "rds-data:*",
        "redshift:GetClusterCredentials*",
        "s3:GetObject*",
        "secretsmanager:BatchGetSecretValue",
        "secretsmanager:GetSecretValue",
        "ssm:GetParameter*"
      ],
      "Resource": "*"
    },
    {
      "Sid": "NothingElseThroughMCP",
      "Effect": "Deny",
      "NotAction": [
        "application-signals:BatchGet*",
        "application-signals:Get*",
        "application-signals:List*",
        "autoscaling:Describe*",
        "ce:Get*",
        "cloudtrail:LookupEvents",
        "cloudwatch:Describe*",
        "cloudwatch:Get*",
        "cloudwatch:ListMetrics",
        "compute-optimizer:Get*",
        "cost-optimization-hub:List*",
        "dynamodb:Describe*",
        "dynamodb:List*",
        "ec2:Describe*",
        "ecr:Describe*",
        "ecr:GetLifecyclePolicy",
        "ecr:GetRepositoryPolicy",
        "ecr:List*",
        "eks:Describe*",
        "eks:List*",
        "elasticache:Describe*",
        "elasticache:ListTagsForResource",
        "elasticfilesystem:Describe*",
        "elasticloadbalancing:Describe*",
        "health:Describe*",
        "iam:GetInstanceProfile",
        "iam:GetPolicy",
        "iam:GetPolicyVersion",
        "iam:GetRole",
        "iam:GetRolePolicy",
        "iam:List*",
        "iam:SimulatePrincipalPolicy",
        "kafka:Describe*",
        "kafka:List*",
        "kms:DescribeKey",
        "kms:Get*",
        "kms:List*",
        "lambda:GetFunctionConcurrency",
        "lambda:GetFunctionConfiguration",
        "lambda:ListEventSourceMappings",
        "logs:Describe*",
        "logs:FilterLogEvents",
        "logs:Get*",
        "logs:StartQuery",
        "logs:StopQuery",
        "memorydb:Describe*",
        "memorydb:ListTags",
        "pi:DescribeDimensionKeys",
        "pi:GetResourceMetrics",
        "pi:ListAvailableResourceMetrics",
        "pricing:Describe*",
        "pricing:Get*",
        "pricing:List*",
        "rds:Describe*",
        "rds:ListTagsForResource",
        "redshift:Describe*",
        "route53:Get*",
        "route53:List*",
        "s3:GetBucketLocation",
        "s3:GetBucketPolicy",
        "s3:GetEncryptionConfiguration",
        "s3:List*",
        "secretsmanager:DescribeSecret",
        "secretsmanager:List*",
        "servicequotas:Get*",
        "servicequotas:ListServiceQuotas",
        "sns:GetTopicAttributes",
        "sns:List*",
        "sqs:Get*",
        "sqs:List*",
        "ssm:DescribeParameters",
        "sts:GetCallerIdentity",
        "support:DescribeTrustedAdvisor*",
        "xray:BatchGetTraces",
        "xray:Get*"
      ],
      "Resource": "*",
      "Condition": {
        "Bool": {
          "aws:ViaAWSMCPService": "true"
        }
      }
    }
  ]
}